        "path": "heat-case-42/run-20260502-120000/_calcchain/rules/heat_solver-rules.json",
        "revision": 2910
      }
    ]
  },

  // Фактическая сборка рабочего окружения.
  "build": {
    "lock": {
      "sha256": "2222222222222222222222222222222222222222222222222222222222222222",
      "sources": [
        {
          "type": "local",
          "path": "D:/jobs/heat-case-42/build.lock.toml"
        },
        {
          "type": "svn",
          "location": "https://svn.example.org/calc-results",
          "path": "heat-case-42/run-20260502-120000/_calcchain/build.lock.toml",
          "revision": 2910
        }
      ]
    },

    "code": {
      "name": "heat_solver",
      "version": "1.2.0",

      // tree_sha256 считается по всем файлам набора:
      // берем sha256 каждого файла, сортируем записи по work_path,
      // складываем хэши в одну строку/bytes-последовательность и еще раз
      // прогоняем через sha256.
      "tree_sha256": "4444444444444444444444444444444444444444444444444444444444444444",

      "source": {
        "type": "local",
        "path": "D:/calc_catalog/heat_solver/1.2.0"
      },

      // Если code был собран без rules, поля rules нет.
      "rules": {
        "set": "code_all",
        "status": "stable"
      },

      // Карта source file -> work file.
      // Массив выбран вместо объекта, чтобы у каждой записи можно было хранить
      // хэш и дополнительные поля.
      "map": [
        {
          "source_path": "bin/heat_solver.exe",
          "work_path": "bin/heat_solver.exe",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
          "source_path": "lib/model.dll",
          "work_path": "lib/model.dll",
          "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      ]
    },

    "inputs": [
      {
        "name": "mesh",
        "tree_sha256": "5555555555555555555555555555555555555555555555555555555555555555",
        "source": {
          "type": "local",
          "path": "D:/calc_inputs/case-42/mesh"
        },
        "rules": {
          "set": "mesh_input",
          "status": "stable"
        },
        "map": [
          {
            "source_path": "case42.msh",
            "work_path": "input/mesh/case42.msh",
            "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
          }
        ]
      },
      {
        "name": "boundary_conditions",
        "tree_sha256": "6666666666666666666666666666666666666666666666666666666666666666",
        "source": {
          "type": "svn",
          "location": "https://svn.example.org/calc-data",
          "path": "cases/case-42/boundary",
          "revision": 1842
        },
        "rules": {
          "set": "bc_input",
          "status": "experimental"
        },
        "map": [
          {
            "source_path": "wall.bc",
            "work_path": "input/boundary/wall.bc",
            "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
          }
        ]
      },
      {
        // Frozen inputs появляются, если пользователь изменил входы перед run
        // или если для воспроизводимости нужно сохранить input из неверсионируемого source.
        "name": "frozen_inputs",
        "tree_sha256": "7777777777777777777777777777777777777777777777777777777777777777",
        "sources": [
          {
            "type": "local",
            "path": "D:/jobs/heat-case-42/.calcchain/frozen_inputs"
          },
          {
            "type": "svn",
            "location": "https://svn.example.org/calc-results",
            "path": "heat-case-42/run-20260502-120000/_calcchain/frozen_inputs",
            "revision": 2910
          }
        ],
        "map": [
          {
            "source_path": "input/mesh/case42.msh",
            "work_path": "input/mesh/case42.msh",
            "sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
          }
        ]
      }
    ]
  },

  // Фактическая публикация результата.
  // Блок отсутствует, если результат еще не публиковался.
  "publication": {
    "lock": {
      "sha256": "8888888888888888888888888888888888888888888888888888888888888888",
      "sources": [
        {
          "type": "local",
          "path": "D:/jobs/heat-case-42/.calcchain/publication/publish.lock.toml"
