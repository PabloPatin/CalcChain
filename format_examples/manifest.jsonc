            "sha256": "1313131313131313131313131313131313131313131313131313131313131313"
          }
        ]
      }
    ],

    // Блок temp пишется только если пользователь явно решил опубликовать
    // один или несколько временных файлов.
    "temp": [
      {
        "name": "debug_temp",
        "tree_sha256": "1414141414141414141414141414141414141414141414141414141414141414",
        "target": {
          "type": "svn",
          "location": "https://svn.example.org/calc-results",
          "path": "heat-case-42/run-20260502-120000/debug_temp",
          "revision": 2910
        },
        "rules": {
          "set": "debug_temp",
          "status": "experimental"
        },
        "map": [
          {
            "work_path": "tmp/intermediate.bin",
