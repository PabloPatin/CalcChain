    // Блок logs пишется только если из logs действительно что-то публиковалось.
    "logs": [
      {
        "name": "solver_logs",
        "tree_sha256": "1212121212121212121212121212121212121212121212121212121212121212",
        "target": {
          "type": "local",
          "path": "D:/published_results/heat-case-42/logs"
        },
        "rules": {
