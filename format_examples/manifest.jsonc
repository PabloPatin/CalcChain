{
  // Версия схемы самого manifest.
  "schema_version": "1.0",

  // Идентификация одной задачи расчета.
  // Пользовательские build.toml/run.toml/publish.toml сюда не входят:
  // manifest описывает фактические процедуры.
  "job": {
    "id": "run-20260502-120000",
    "created_at": "2026-05-02T12:35:20+03:00",
    "status": "Published",
    "job_dir": "D:/jobs/heat-case-42",
    "user": "DOMAIN/user",
    "hostname": "calc-ws-01"
  },

  // Фактический запуск расчетного процесса.
  // Блок отсутствует, если manifest создан только после build.
  "run": {
    "command": ["bin/heat_solver.exe", "--case", "input"],
    "cwd": "D:/jobs/heat-case-42/work",
    "timeout_seconds": 3600,
    "encoding": "utf-8",

    "env": {
      "OMP_NUM_THREADS": "4",
      "CALCCHAIN_MODE": "run",
      "secrets": ["LICENSE_TOKEN"]
    },

    "stdin": {
      "mode": "script",
      "text": "start\nconfirm\n",
      "log": {
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "sources": [
          {
            "type": "local",
            "path": "D:/jobs/heat-case-42/.calcchain/logs/stdin.log"
          },
          {
            "type": "svn",
            "location": "https://svn.example.org/calc-results",
            "path": "heat-case-42/run-20260502-120000/_calcchain/logs/stdin.log",
            "revision": 2910
          }
        ]
      }
    },

    // stdout/stderr log blocks добавляются, если соответствующие локальные логи есть.
    // Если логи опубликованы, добавляется второй source с target revision.
    "stdout": {
      "log": {
        "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "sources": [
          {
            "type": "local",
            "path": "D:/jobs/heat-case-42/.calcchain/logs/stdout.log"
          },
          {
            "type": "svn",
            "location": "https://svn.example.org/calc-results",
            "path": "heat-case-42/run-20260502-120000/_calcchain/logs/stdout.log",
            "revision": 2910
          }
        ]
      }
    },

    "stderr": {
      "log": {
        "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "sources": [
          {
            "type": "local",
            "path": "D:/jobs/heat-case-42/.calcchain/logs/stderr.log"
          },
          {
            "type": "svn",
            "location": "https://svn.example.org/calc-results",
            "path": "heat-case-42/run-20260502-120000/_calcchain/logs/stderr.log",
            "revision": 2910
          }
        ]
      }
    },

    "status": "Succeeded",
    "return_code": 0,

    // Список файлов рабочей области, помеченных после run.
    // Это не карта публикации и не список всех файлов с хэшами, а классификация
    // относительных путей в work dir.
    "file_groups": {
      "code": [
        "bin/heat_solver.exe",
        "lib/model.dll"
      ],
      "inputs": [
        "input/mesh/case42.msh",
        "input/boundary/wall.bc"
      ],
      "outputs": [
        "results/temperature.csv",
        "results/report.txt"
      ],
      "logs": [
        "logs/solver.log"
      ],
      "temp": [
        "tmp/intermediate.bin"
      ],
      "ignored": [
        "cache/runtime.cache"
      ],
      "unknown": [
        "unexpected/debug_dump.bin"
      ]
    },

    "started_at": "2026-05-02T12:01:00+03:00",
    "finished_at": "2026-05-02T12:35:10+03:00"
  },

  // Общий файл правил, если он использовался при build или publication.
  "rules": {
    "sha256": "3333333333333333333333333333333333333333333333333333333333333333",
    "sources": [
      {
        "type": "local",
        "path": "D:/jobs/heat-case-42/.calcchain/rules/heat_solver-rules.json"
      },
      {
        "type": "local",
        "path": "D:/calc_catalog/rules/heat_solver-rules.json"
      },
